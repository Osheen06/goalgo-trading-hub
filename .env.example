# GOALGO — environment variables (NAMES ONLY, never commit real values)
#
# Local development: copy to `.env` and fill in.
# Production: these live in /etc/goalgo/goalgo.env on the VPS (chmod 600),
#             see deploy/goalgo.env.example and DEPLOYMENT.md.

# =============================================================================
# PUBLIC — shipped to the browser by design, contains nothing secret
# =============================================================================

# Public address of GOALGO, e.g. https://goalgo.fairwoodit.com
APP_URL=

# Supabase publishable (anon) configuration — safe in client code
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# SERVER-SIDE SECRETS — never exposed to the browser, never committed
# =============================================================================

# OpenAlgo instance that executes all trading actions.
# In production this is the private localhost address, e.g. http://127.0.0.1:5000
OPENALGO_BASE_URL=
OPENALGO_API_KEY=

# OpenAlgo strategy webhook that GOALGO forwards TradingView alerts to
OPENALGO_STRATEGY_WEBHOOK_URL=

# Shared secret TradingView must send to the GOALGO webhook
# (header x-goalgo-token, or ?token= query parameter). openssl rand -hex 32
GOALGO_WEBHOOK_TOKEN=

# Optional override. Normally left empty: the first account that registers
# becomes the deployment owner automatically and later signups are refused.
# GOALGO_OWNER_USER_ID=


# Database / auth (server side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# RUNTIME (production service only)
# =============================================================================
# NODE_ENV=production
# PORT=3000
# HOST=127.0.0.1
