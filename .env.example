# GOALGO — required server environment variables (names only, never commit real values)

# Public site address, used to build the TradingView webhook URL
APP_URL=

# OpenAlgo instance that executes all trading actions
OPENALGO_BASE_URL=
OPENALGO_API_KEY=

# OpenAlgo strategy webhook that GOALGO forwards TradingView alerts to
OPENALGO_STRATEGY_WEBHOOK_URL=

# Shared secret TradingView must send to the GOALGO webhook
# (header x-goalgo-token, or ?token= query parameter)
GOALGO_WEBHOOK_TOKEN=

# Optional: user id that inbound webhook signals are attributed to
GOALGO_OWNER_USER_ID=

# Database / auth (provisioned by Lovable Cloud; set manually for self-hosting)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
