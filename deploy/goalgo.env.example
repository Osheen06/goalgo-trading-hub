# ---------------------------------------------------------------------------
# /etc/goalgo/goalgo.env  —  PRODUCTION SECRETS (server side only)
#
#   sudo install -m 600 -o root -g goalgo deploy/goalgo.env.example /etc/goalgo/goalgo.env
#   sudo nano /etc/goalgo/goalgo.env
#
# Never commit a filled-in copy of this file. systemd reads it; the browser
# never sees anything here except the two VITE_ values, which are public by
# design (they are the same values Supabase ships in client code).
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# --- PUBLIC (safe to appear in the browser bundle) ---------------------------
# Public address of GOALGO itself
APP_URL=https://app.goalgo.fairwoodit.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- SERVER-SIDE SECRETS (never sent to the browser) -------------------------
# Existing OpenAlgo install on this VPS. Keep it on localhost if possible.
OPENALGO_BASE_URL=https://goalgo.fairwoodit.com
OPENALGO_API_KEY=

# OpenAlgo strategy webhook that GOALGO forwards TradingView alerts to
# (from OpenAlgo: Strategy -> webhook URL)
OPENALGO_STRATEGY_WEBHOOK_URL=

# Secret TradingView must send to GOALGO. Generate with: openssl rand -hex 32
GOALGO_WEBHOOK_TOKEN=

# Supabase user id that inbound signals are attributed to (the single trader)
GOALGO_OWNER_USER_ID=

# Database / auth
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
