# ---------------------------------------------------------------------------
# /etc/goalgo/goalgo.env  —  PRODUCTION ENVIRONMENT (server side)
#
# You normally do NOT create this file by hand. `sudo ./deploy/deploy.sh`
# creates it, fills every value it can derive automatically, generates the
# webhook token, and asks for the remaining secrets with hidden input.
#
# This example exists only as a reference and for unattended installs. Never
# commit a filled-in copy. File mode must be 600, owner root:goalgo.
# ---------------------------------------------------------------------------

# --- Runtime (set automatically by deploy.sh) --------------------------------
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# --- PUBLIC values (safe in the browser bundle; set automatically) -----------
APP_URL=https://goalgo.fairwoodit.com
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- OpenAlgo (private, same server, set automatically) ----------------------
# OpenAlgo listens on localhost only and is never published. GOALGO reaches it
# over the loopback interface; no second domain and no open port are required.
OPENALGO_BASE_URL=http://127.0.0.1:5000

# --- SERVER-SIDE SECRETS (never sent to the browser) -------------------------
# Asked interactively by deploy.sh — required.
# Source: OpenAlgo web UI -> API Key.
OPENALGO_API_KEY=

# Generated automatically by deploy.sh (openssl rand -hex 32) and reused on
# every later run. Shown inside GOALGO on the TradingView page.
GOALGO_WEBHOOK_TOKEN=

# Asked interactively by deploy.sh — optional.
# Source: OpenAlgo web UI -> Strategy -> your strategy -> Webhook URL.
# OpenAlgo has no API that lists it, so it is pasted once. Until it is set,
# GOALGO reports "TradingView not configured" and everything else still runs.
OPENALGO_STRATEGY_WEBHOOK_URL=

# Asked interactively by deploy.sh — optional.
# Privileged database key, used only so inbound TradingView webhooks can be
# recorded. Without it, signed-in pages work normally and the webhook endpoint
# answers 503 "Signal storage is not configured".
SUPABASE_SERVICE_ROLE_KEY=

# --- Not required ------------------------------------------------------------
# GOALGO_OWNER_USER_ID is optional. The first account that registers becomes
# the deployment owner automatically (public.app_owner), and later
# registrations are refused by the database. Set this only to override that.
# GOALGO_OWNER_USER_ID=
